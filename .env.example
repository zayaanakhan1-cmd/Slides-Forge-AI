# SlidesForge AI environment variables.
# Copy this file to .env and fill in the values you need.
# Nothing here is required to run the Phase 1 foundation except where noted.

# --- Frontend (Next.js) -----------------------------------------------------
# Base URL of the app. Used for absolute links and metadata.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Database (PostgreSQL via Prisma) ---------------------------------------
# Required only when you want to run Prisma commands against a real database.
# The Phase 1 foundation does not connect to a database.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/slidesforge?schema=public

# --- Python service ---------------------------------------------------------
# Base URL of the FastAPI service. Required to verify the health endpoint.
SLIDESFORGE_PYTHON_URL=http://localhost:8000

# --- AI providers (planned) -------------------------------------------------
# No provider is registered in Phase 1. These are placeholders for the
# providers that will be implemented next. Leave blank until then.
GEMINI_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=

# --- Destination integrations (planned) -------------------------------------
# Google OAuth is required for Google Slides export, which is not implemented.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/integrations/google/callback
