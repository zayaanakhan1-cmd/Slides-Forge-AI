# SlidesForge AI environment variables.
# Copy this file to .env and fill in the values you need.
# Nothing here is required to run the Phase 1 foundation except where noted.

# --- Frontend (Next.js) -----------------------------------------------------
# Base URL of the app. Used for absolute links and metadata.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Database (PostgreSQL via Prisma) ---------------------------------------
# Required only when you want to run Prisma commands against a real database.
# The Phase 1 foundation does not connect to a database.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/slidesforge?schema=public

# --- Python service ---------------------------------------------------------
# Base URL of the FastAPI service. Required to verify the health endpoint.
SLIDESFORGE_PYTHON_URL=http://localhost:8000

# --- AI providers -----------------------------------------------------------
# SlidesForge AI ships one provider: an OpenAI-compatible chat-completions
# client. It works with OpenAI, Groq, Together, OpenRouter, vLLM and any other
# endpoint that implements /chat/completions.
#
# Generation is only possible when SLIDESFORGE_AI_API_KEY is set. Without it the
# API returns a structured 503 "provider_not_configured" error rather than
# fabricating a presentation.
SLIDESFORGE_AI_API_KEY=
# Endpoint base URL. Defaults to https://api.openai.com/v1
SLIDESFORGE_AI_BASE_URL=https://api.openai.com/v1
# Model id used when a call does not override it. Defaults to gpt-4o-mini
SLIDESFORGE_AI_MODEL=gpt-4o-mini
# Per-request timeout in milliseconds. Defaults to 60000
SLIDESFORGE_AI_TIMEOUT_MS=60000

# Alternative OpenAI-compatible endpoints, for reference:
#   Groq:       SLIDESFORGE_AI_BASE_URL=https://api.groq.com/openai/v1
#   OpenRouter: SLIDESFORGE_AI_BASE_URL=https://openrouter.ai/api/v1
#   Together:   SLIDESFORGE_AI_BASE_URL=https://api.together.xyz/v1

# --- Destination integrations (planned) -------------------------------------
# Google OAuth is required for Google Slides export, which is not implemented.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/integrations/google/callback
